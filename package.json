    "fast-xml-parser": "^5.10.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
